{
  "name": "@dbx-tools/dbx-model-catalog-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/js/*"
  ],
  "catalog": {
    "@chanx-js/client": "2.3.2",
    "@databricks/appkit-ui": "0.81.0",
    "@dbx-tools/ui": "^0.9.196",
    "@lobehub/icons": "^6.13.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "bun-plugin-tailwind": "^0.1.2",
    "fuse.js": "^7.4.2",
    "lucide-react": "^0.554.0",
    "pynect": "^1.0.0",
    "react": "~19.2.4",
    "react-dom": "~19.2.4",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@chanx-js/client": "catalog:"
  },
  "scripts": {
    "generate": "bun packages/js/client/scripts/generate.ts",
    "typecheck": "bun run typecheck:client && bun run typecheck:web",
    "typecheck:client": "bun run tsc --noEmit -p packages/js/client/tsconfig.json",
    "typecheck:web": "bun run tsc --noEmit -p packages/js/web/tsconfig.json",
    "build": "bun run generate && bun run build:client && bun run build:web && uv build --package dbx-model-catalog",
    "build:client": "bun packages/js/client/scripts/build.ts",
    "build:web": "bun packages/js/web/scripts/build.ts",
    "check": "bun run generate && bun run build:client && uv run --project packages/py/core pytest packages/py/core/tests && uv run --project packages/py/sync pytest packages/py/sync/tests && bun test packages/js/client/test packages/js/web/test && bun run typecheck && bun run build:web && uv build --package dbx-model-catalog",
    "serve": "bun run generate && bun run build:client && bun run build:web && DBX_MODEL_CATALOG_PATH=packages/js/web/catalog.json uv run --project packages/py/server uvicorn dbx_model_catalog_server.app:app --host 127.0.0.1 --port 8787",
    "chanx-model-catalog": "bun packages/js/client/src/cli.ts",
    "sync": "uv run --project packages/py/sync dbx-model-catalog-sync",
    "catalog:publish": "uv run --project packages/py/sync dbx-model-catalog-sync --output-directory packages/js/web"
  },
  "devDependencies": {
    "@databricks/appkit-ui": "catalog:",
    "@dbx-tools/ui": "catalog:",
    "@lobehub/icons": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "bun-plugin-tailwind": "catalog:",
    "lucide-react": "catalog:",
    "pynect": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:"
  }
}
