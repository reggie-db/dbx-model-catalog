{
  "name": "dbx-model-catalog-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/node"
  ],
  "overrides": {
    "loqkit": "^0.8.5",
    "optionkit": "^0.8.5",
    "pyfig": "^0.8.5",
    "pynect": "^0.8.5",
    "tslib": "2.8.1"
  },
  "scripts": {
    "build": "hatch run build",
    "catalog:publish": "uv run --project packages/python python packages/python/scripts/publish_catalog.py",
    "check": "hatch run check",
    "sync": "bun packages/node/src/cli.ts sync",
    "test": "hatch run test",
    "node:generate": "bun run --cwd packages/node generate",
    "node:build": "bun run --cwd packages/node build",
    "node:pack": "bun run --cwd packages/node pack",
    "site:build": "bun scripts/build-site.ts",
    "site:check": "bun run site:typecheck && bun run site:build",
    "site:serve": "bun run --cwd packages/node serve",
    "site:typecheck": "bunx tsc --noEmit -p site/tsconfig.json"
  },
  "devDependencies": {
    "@databricks/appkit-ui": "0.81.0",
    "@dbx-tools/ui": "^0.9.196",
    "@lobehub/icons": "^6.13.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "bun-plugin-tailwind": "^0.1.2",
    "lucide-react": "^0.554.0",
    "react": "~19.2.4",
    "react-dom": "~19.2.4",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0"
  }
}
