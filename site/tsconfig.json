{
  "compilerOptions": {
    "lib": ["DOM", "ES2024"],
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../packages/node/src/rpc.ts", "../packages/node/src/generated/**/*.ts"]
}
