{
  "name": "@dbx-tools/dbx-model-catalog",
  "version": "0.1.7",
  "description": "Node and browser client for the published Databricks model catalog",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reggie-db/dbx-model-catalog.git",
    "directory": "packages/js/client"
  },
  "homepage": "https://github.com/reggie-db/dbx-model-catalog/tree/main/packages/js/client#readme",
  "bugs": {
    "url": "https://github.com/reggie-db/dbx-model-catalog/issues"
  },
  "engines": {
    "node": "^22.12.0 || >=24.10.0 <=26.x",
    "bun": ">=1.2.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dbx-model-catalog": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./pynect": {
      "types": "./dist/pynect.d.ts",
      "import": "./dist/pynect.js",
      "default": "./dist/pynect.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.ts",
      "import": "./dist/snapshot.js",
      "default": "./dist/snapshot.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun scripts/build.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@chanx-js/client": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "pynect": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@chanx-js/client": "2.3.2",
    "pynect": "1.0.0"
  },
  "peerDependenciesMeta": {
    "@chanx-js/client": {
      "optional": true
    },
    "pynect": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
