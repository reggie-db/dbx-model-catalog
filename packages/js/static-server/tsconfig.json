{
  "compilerOptions": {
    "lib": ["ES2023"],
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["bun", "node"],
    "verbatimModuleSyntax": true
  },
  "include": ["src", "test"]
}
