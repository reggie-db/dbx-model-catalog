{
  "name": "@regbo/dbx-model-catalog",
  "version": "0.1.0",
  "description": "Generated Node and Bun client for the Python dbx-model-catalog package",
  "type": "module",
  "bin": {
    "dbx-model-catalog": "./dist/cli.js"
  },
  "engines": {
    "node": "^22.11.0 || >=24.10.0 <=26.x"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "py"
  ],
  "scripts": {
    "cli": "bun src/cli.ts",
    "generate": "bun scripts/generate.ts",
    "bundle": "bun scripts/build.ts && bunx tsc -b tsconfig.json --force",
    "build": "bun run generate && bun run bundle",
    "pack": "bun run build && bun pm pack --destination dist-package",
    "prepublishOnly": "bun run build",
    "serve": "bun ../../scripts/build-site.ts && bun src/server.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@antfu/install-pkg": "^2.1.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.10.0",
    "elysia": "^1.4.30",
    "fireargs": "^0.6.2",
    "http-proxy-3": "^2.0.2",
    "json-schema-to-typescript": "^16.0.0",
    "pyfig": "^0.8.5",
    "pynect": "^0.8.5",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "fireargs": "^0.6.2"
  },
  "peerDependenciesMeta": {
    "fireargs": {
      "optional": true
    }
  },
  "sideEffects": false
}
